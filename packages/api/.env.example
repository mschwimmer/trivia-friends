# Postgres (matches the local Docker Compose service)
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/monorepo_dev

# API
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Firebase Admin (used when authentication is implemented)
FIREBASE_PROJECT_ID=

# Session security (used when guest hosting is implemented)
GUEST_TOKEN_PEPPER=replace-with-a-long-random-value
